# ===== MCP (obrigatorio) =====
# Gere um token aleatorio e armazene aqui apenas o SHA-256 dele (printf '%s' 'TOKEN' | sha256sum).
AUTH_TOKEN_SHA256=substitua-por-um-hash-sha256-de-64-caracteres-hexadecimais

# Host publico exato encaminhado pelo Traefik (ou a lista de hosts, separada por virgula).
MCP_DOMAIN=mcp.seudominio.com
# Opcional: sobrescreve MCP_ALLOWED_HOSTS (default: MCP_DOMAIN).
# MCP_ALLOWED_HOSTS=

# Deixe vazio para rejeitar qualquer cliente que envie Origin. Para clientes web,
# informe origins HTTPS exatas separadas por virgula.
MCP_ALLOWED_ORIGINS=

# Nomes Docker exatos que o gateway pode expor; curingas nao sao aceitos.
ALLOWED_CONTAINERS=app-1,db-1

# ===== Modo operacao (ops) =====
# Habilita os tools de operacao (shell, docker_*, deploy, read/write, list_dir, pg_query)
# validados pelo arquivo de allowlist.
ENABLE_OPS_TOOLS=false
# Caminho da allowlist dentro do container. Em modo ops, monte um arquivo neste caminho.
OPS_ALLOWLIST_PATH=/app/ops-allowlist.json
# Limite de saida (bytes) dos tools de operacao.
OPS_MAX_OUTPUT_BYTES=1048576

# ===== Logs Docker (opt-in) =====
# Logs podem conter segredos e texto adversarial. Desativada por padrao.
ENABLE_DOCKER_LOGS=false
MAX_LOG_BYTES=131072

# ===== Traefik (ajuste a cada VPS) =====
# Nome da rede externa do Traefik nesta VPS.
TRAEFIK_NETWORK=web
TRAEFIK_ENABLE=true
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_RATE_AVERAGE=10
TRAEFIK_RATE_BURST=20
TRAEFIK_STS_SECONDS=31536000

# ===== Identidade / transporte =====
SERVICE_NAME=vps-observer-mcp
COMPOSE_PROJECT_NAME=mcp
MCP_PORT=3000
TRUST_PROXY_HOPS=1
RATE_LIMIT_PER_MINUTE=120
REQUEST_BODY_LIMIT=64kb
GATEWAY_TIMEOUT_MS=10000
MAX_GATEWAY_RESPONSE_BYTES=524288

# ===== Gateway Docker =====
# Caminho do socket Docker montado no gateway (default: /var/run/docker.sock).
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Modo proxy (alternativa ao socket direto): defina DOCKER_SOCKET_PATH vazio e preencha DOCKER_PROXY_URL.
# DOCKER_SOCKET_PATH=
# DOCKER_PROXY_URL=http://docker-proxy:2375
DOCKER_TIMEOUT_MS=8000
MAX_DOCKER_JSON_BYTES=1048576

# ===== Imagens / recursos =====
GATEWAY_IMAGE=vps-observer-gateway:local
MCP_IMAGE=vps-observer-mcp:local
GATEWAY_PORT=8080
GATEWAY_SERVICE_NAME=docker-read-gateway
PULL_POLICY=missing
MCP_MEM_LIMIT=512m
MCP_CPUS=1.00
MCP_PIDS_LIMIT=128
GATEWAY_MEM_LIMIT=128m
GATEWAY_CPUS=0.50
GATEWAY_PIDS_LIMIT=64
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
