{
  "name": "vps-observer-mcp",
  "version": "3.0.0",
  "description": "Servidor MCP para gerenciamento de containers Docker com permissoes centralizadas.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "node --test",
    "pretest": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "docker",
    "observability",
    "security"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.14.0"
}
